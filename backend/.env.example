# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/recruiting_db
ASYNC_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/recruiting_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Storage Configuration (Local)
UPLOAD_DIR=./uploads
FAISS_INDEX_PATH=./data/faiss_index
MODEL_CACHE_PATH=./data/models

# API Configuration
API_V1_PREFIX=/api/v1
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LLM Configuration
# Ollama (On-premise)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# OpenAI (Optional)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4

# Anthropic (Optional)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Default LLM Provider (ollama|openai|anthropic)
DEFAULT_LLM_PROVIDER=ollama

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your-client-id
LINKEDIN_CLIENT_SECRET=your-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/integrations/linkedin/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/callback

# Search Configuration
SEARCH_TOP_K=100
RERANK_TOP_K=20

# Environment
ENVIRONMENT=development
DEBUG=True
